{
  "name": "alwalea-modern-bakery",
  "productName": "Alwalea Modern Bakery",
  "version": "1.0.0-rc.11",
  "description": "نظام إدارة مخبز الولاء الحديث — إلكترون دسكتوب (SQLite عبر sql.js WASM)",
  "main": "dist-electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Alwalea Modern Bakery",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:icon": "node scripts/gen-icon.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "smoke": "electron . --smoke",
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "qa": "bun scripts/qa-suite.ts",
    "verify": "bun run lint && bun run qa"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
